# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Where to create ticket channels (Category ID is optional but recommended)
TICKETS_CATEGORY_ID=

# Database (Prisma/Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
STAFF_ROLE_ID=
REQUIRE_STAFF_REVIEW=true

# Dashboard admin login (username: admin); use a unique secret of at least 16 characters
ADMIN_PASSWORD=replace-with-a-unique-secret
# Khuyến nghị production: salt:hash tạo bằng crypto.scrypt; khi có giá trị này bot sẽ ưu tiên hơn ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# Server & Network
PORT=3000
TRUST_PROXY=loopback

# Role to customer
CUSTOMER_ROLE_ID=

# PAYMENT & BANK
BANK_NAME="MB Bank"
BANK_ACCOUNT=""
BANK_OWNER=""
PAYMENT_LOG_CHANNEL_ID=""


# GPM Pay (@gpmpay/sdk) — https://app.gpmpay.com/api-tokens
GPMPAY_API_TOKEN=          # bắt buộc khi gọi API GPM Pay — Scope: webhooks:manage, bank-accounts:read, transactions:read
GPMPAY_WEBHOOK_SECRET=     # bắt buộc nếu nhận webhook (lấy sau khi tạo endpoint)
GPMPAY_API_URL=https://api.gpmpay.com/api/v1

# LOGS
STATS_CHANNEL_ID=
SALES_LOG_CHANNEL_ID=
ADMIN_LOG_CHANNEL_ID=      # where staff actions are logged
ANNOUNCEMENTS_CHANNEL_ID=  # where /announce posts
RATE_LIMIT_MINUTES=10      # min gap between tickets per user

BILLING_DAYS=30
