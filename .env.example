# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Where to create ticket channels (Category ID is optional but recommended)
TICKETS_CATEGORY_ID=

# Database (Prisma/SQLite)
DATABASE_URL="file:./dev.db"
STAFF_ROLE_ID=
REQUIRE_STAFF_REVIEW=true

# Dashboard admin login (username: admin); use a unique secret of at least 16 characters
ADMIN_PASSWORD=replace-with-a-unique-secret

# Server & Network
PORT=3000
TRUST_PROXY=loopback

# Role to customer
CUSTOMER_ROLE_ID=

# PAYMENT & BANK
BANK_NAME="MB Bank"
BANK_ACCOUNT=""
BANK_OWNER=""
BANK_QR=""
UPI_ID=yourname@upi

# GPM Pay Auto Payment Webhook (Set GPM_PAY_ENABLED=true when activating live)
GPM_PAY_ENABLED=false
GPM_PAY_WEBHOOK_SECRET=replace-with-webhook-secret

# LOGS
STATS_CHANNEL_ID=
SALES_LOG_CHANNEL_ID=
ADMIN_LOG_CHANNEL_ID=      # where staff actions are logged
ANNOUNCEMENTS_CHANNEL_ID=  # where /announce posts
RATE_LIMIT_MINUTES=10      # min gap between tickets per user

BILLING_DAYS=30
